{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VMA Data Extractor",
  "version": "1.0.0",
  "identifier": "com.vmatool.extractor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VMA Data Extractor",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
